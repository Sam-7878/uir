{
  "tcb_version": "3.0.0",
  "specification": "HETE Zero-Trust Architecture",
  "last_updated": "2026-09-08",
  "components": [
    {
      "name": "InputGuard",
      "in_tcb": true,
      "is_neural": false,
      "input": "raw_user_text",
      "output": "guarded_input",
      "writes_authority": false,
      "failure_mode": "fail_closed_on_overflow"
    },
    {
      "name": "LanguageRouter",
      "in_tcb": true,
      "is_neural": false,
      "input": "normalized_text",
      "output": "selected_frontend",
      "writes_authority": false,
      "failure_mode": "default_to_english"
    },
    {
      "name": "EnglishFrontend",
      "in_tcb": true,
      "is_neural": false,
      "input": "english_text",
      "output": "parsed_draft",
      "writes_authority": false,
      "failure_mode": "unknown_intent"
    },
    {
      "name": "KoreanFrontend",
      "in_tcb": true,
      "is_neural": false,
      "input": "korean_text",
      "output": "parsed_draft",
      "writes_authority": false,
      "failure_mode": "unknown_intent"
    },
    {
      "name": "UirBuilder",
      "in_tcb": true,
      "is_neural": false,
      "input": "parsed_draft_and_security_context",
      "output": "uir_document",
      "writes_authority": true,
      "failure_mode": "schema_validation_error"
    },
    {
      "name": "ProvenanceVerifier",
      "in_tcb": true,
      "is_neural": false,
      "input": "retrieved_evidence_records",
      "output": "typed_evidence_records",
      "writes_authority": true,
      "failure_mode": "quarantine_unverified"
    },
    {
      "name": "ContextFirewall",
      "in_tcb": true,
      "is_neural": false,
      "input": "evidence_text",
      "output": "sanitized_evidence_context",
      "writes_authority": false,
      "failure_mode": "quarantine_instruction_bearing"
    },
    {
      "name": "SecurityPolicyEngine",
      "in_tcb": true,
      "is_neural": false,
      "input": "uir_and_evidence",
      "output": "policy_decision",
      "writes_authority": true,
      "failure_mode": "default_deny"
    },
    {
      "name": "CapabilityGate",
      "in_tcb": true,
      "is_neural": false,
      "input": "tool_call_request",
      "output": "execution_verdict",
      "writes_authority": true,
      "failure_mode": "deny_unauthorized"
    },
    {
      "name": "ResourceTracker",
      "in_tcb": true,
      "is_neural": false,
      "input": "resource_usage_metrics",
      "output": "budget_verdict",
      "writes_authority": true,
      "failure_mode": "hard_terminate"
    },
    {
      "name": "OutputGuard",
      "in_tcb": true,
      "is_neural": false,
      "input": "raw_model_generation",
      "output": "sanitized_egress",
      "writes_authority": true,
      "failure_mode": "suppress_and_redact"
    },
    {
      "name": "LargeLanguageModel",
      "in_tcb": false,
      "is_neural": true,
      "input": "rendered_prompt",
      "output": "candidate_generation",
      "writes_authority": false,
      "failure_mode": "untrusted_generation"
    }
  ]
}
