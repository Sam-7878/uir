{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uir:restricted-cnl:v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "input_route", "contract", "unit", "system_constraints", "user_condition"],
  "properties": {
    "schema_version": {"const": "uir-cnl-v2"},
    "input_route": {"const": "raw_only"},
    "unit": {"type": ["string", "null"]},
    "system_constraints": {"const": ["verified_provenance"]},
    "contract": {
      "type": "object", "additionalProperties": false,
      "required": ["entity", "attribute", "period", "policy_snapshot", "evidence_snapshot", "action", "version"],
      "properties": {
        "entity": {"type": "string", "pattern": "^[A-Z][A-Z0-9._-]{0,15}$"},
        "attribute": {"enum": ["revenue", "net_income", "operating_income"]},
        "period": {"type": "string", "pattern": "^(19|20)[0-9]{2}$"},
        "policy_snapshot": {"type": "string"}, "evidence_snapshot": {"type": "string"},
        "action": {"const": "read"}, "version": {"const": "uir-reference-v1"}
      }
    },
    "user_condition": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/condition"}]}
  },
  "$defs": {
    "condition": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["op", "arg"],
       "properties": {"op": {"const": "NOT"}, "arg": {"$ref": "#/$defs/condition"}}},
      {"type": "object", "additionalProperties": false, "required": ["op", "args"],
       "properties": {"op": {"enum": ["AND", "OR"]}, "args": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/condition"}}}},
      {"type": "object", "additionalProperties": false, "required": ["field", "op", "type", "value"],
       "properties": {"field": {"enum": ["approval", "entity_verified", "verified_provenance"]}, "op": {"enum": ["==", "!="]},
                      "type": {"const": "BOOLEAN"}, "value": {"type": "boolean"}}},
      {"type": "object", "additionalProperties": false, "required": ["field", "op", "type", "value"],
       "properties": {"field": {"const": "value"}, "op": {"enum": ["==", "!=", ">", "<", ">=", "<="]},
                      "type": {"const": "DECIMAL"}, "value": {"type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?$"}}}
    ]}
  }
}
