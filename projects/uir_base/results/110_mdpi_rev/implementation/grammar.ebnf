request = base, [ unit ], [ conditional ];
base = "verify ", entity, " ", metric_en, " ", year
     | entity, "의 ", year, "년 ", metric_ko, " 검증";
metric_en = "revenue" | "net_income" | "operating_income";
metric_ko = "매출" | "순이익" | "영업이익";
unit = " in ", unit_name | " 단위 ", unit_name;
conditional = (" if " | " only if " | " unless " | " 조건: "), expression;
expression = conjunction, { ("OR" | "또는"), conjunction };
conjunction = atom, { ("AND" | "그리고"), atom };
atom = ("NOT" | "아님"), atom | "(", expression, ")" | comparison;
comparison = bool_field, [ ("==" | "!="), bool_value ]
           | ("value" | "값"), comparator, decimal;
bool_field = "approval" | "승인" | "entity_verified" | "기업확인"
           | "verified_provenance" | "출처확인";
bool_value = "true" | "false" | "참" | "거짓";
comparator = "==" | "!=" | ">=" | "<=" | ">" | "<";
(* Entity: ASCII [A-Z][A-Z0-9._-]{0,15}; year: (19|20)[0-9]{2}.
   unit_name: [A-Z]{3}, percent or 1; decimal: -?[0-9]+(.[0-9]+)?.
   Whitespace required at request markers; conditions use token whitespace.
   No free prose, temporal ranges, opaque code, arbitrary fields or arithmetic
   condition expressions. Unsupported input -> CLARIFICATION_REQUIRED. *)
