{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uir:reference:v1",
  "title": "Revision reference runtime contract, not the historical full Rust UIR",
  "type": "object",
  "additionalProperties": false,
  "required": ["entity", "attribute", "period", "policy_snapshot", "evidence_snapshot", "action", "version"],
  "properties": {
    "entity": {"type": "string", "pattern": "^[A-Z][A-Z0-9._-]{0,15}$"},
    "attribute": {"enum": ["revenue", "net_income", "operating_income"]},
    "period": {"type": "string", "pattern": "^(19|20)[0-9]{2}$"},
    "policy_snapshot": {"type": "string", "minLength": 1},
    "evidence_snapshot": {"type": "string", "minLength": 1},
    "action": {"enum": ["read", "write"]},
    "version": {"const": "uir-reference-v1"}
  }
}
